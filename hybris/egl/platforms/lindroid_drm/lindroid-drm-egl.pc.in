prefix=@prefix@
exec_prefix=${prefix}
libdir=@libdir@
includedir=@includedir@

Name: lindroid-drm-egl
Description: libhybris EGL platform library
Version: @VERSION@
Libs: -L${libdir} -lgbm -lhybris-hwcomposerwindow
Cflags: -I/usr/include/libdrm -I${includedir} -I${includedir}/hybris/hwcomposerwindow

